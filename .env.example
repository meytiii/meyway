# ==============================================================================
# Railway Environment Variables Template
# Copy and paste these into: Railway Dashboard -> Service -> Variables
# ==============================================================================

# Mandatory Railway container configuration
PORT=8080
DATA_DIR=/data

# Stealth & Secret-Path Gating (Change these to unique random strings)
ADMIN_SECRET_PATH=manage-k82x
PORTAL_SECRET_PATH=portal-v49q
SUB_SECRET_PATH=sub-w71p

# Camouflaged HTTP Edge Transport Path (Base path for WS / gRPC / XHTTP)
TRANSPORT_PATH_PREFIX=/api/v2/stream

# Optional: Reverse proxy an external benign site as the decoy front
# e.g., https://news.ycombinator.com or leave empty to serve built-in blog decoy
DECOY_UPSTREAM_URL=

# Non-HTTP Proxy Listeners (Disabled by default on single-port Railway HTTP edge)
ENABLE_RAW_HTTP_PROXY=false
ENABLE_SOCKS5=false
ENABLE_MTPROTO=false

# Logging & Session Hardening
VERBOSE_STARTUP_LOGS=false
SESSION_COOKIE_NAME=sid
APP_BRAND=Console

# Allow running without volume attached (Local development only; set to 0 for Railway)
NL_ALLOW_EPHEMERAL=0
